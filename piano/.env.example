# Скопируй в .env. Не добавляй настоящий .env в Git.
PORT=4173
# Новый токен бота добавляется только на сервере, не в браузере и не в репозитории.
TELEGRAM_BOT_TOKEN=
# Можно заполнить вручную или получить командой npm run telegram:link.
TELEGRAM_CHAT_ID=
# Придумай отдельный длинный пароль (минимум 12 символов).
APP_PASSWORD=
